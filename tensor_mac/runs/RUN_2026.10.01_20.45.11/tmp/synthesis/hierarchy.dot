n5:e -> c13:p10:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n6:e -> c13:p9:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n7:e -> p0:w [color="black", fontcolor="black", label=""];
