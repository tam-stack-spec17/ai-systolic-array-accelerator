n6 [ shape=octagon, label="weight", color="black", fontcolor="black" ];
n7 [ shape=octagon, label="reset", color="black", fontcolor="black" ];
n8 [ shape=octagon, label="clk", color="black", fontcolor="black" ];
c12 [ shape=record, label="{{<p9> A|<p10> B}|$3\n$add|{<p11> Y}}",  ];
c13 [ shape=record, label="{{<p9> A|<p10> B}|$2\n$mul|{<p11> Y}}",  ];
p0 [shape=box, style=rounded, label="PROC $1\n/openlane/designs/tensor_mac/src/tensor_mac.v:8.5-14.8"];
c12:p11:e -> p0:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
